    <!-- JavaScript للتنقل والتفاعل -->
    <script>
        // تبديل الأقسام عبر الشريط الجانبي والشاشة
        function switchSection(sectionId, element) {
            // إخفاء جميع الأقسام
            document.querySelectorAll('main section').forEach(sec => {
                sec.classList.remove('active-section');
            });

            // إظهار القسم المطلوب
            document.getElementById(sectionId).classList.add('active-section');

            // تحديث العنصر النشط في القائمة
            document.querySelectorAll('.sidebar-menu a').forEach(link => {
                link.classList.remove('active');
            });
            if(element) {
                element.classList.add('active');
            }

            // إغلاق الشريط الجانبي في الجوال تلقائياً عند النقر
            if(window.innerWidth <= 992) {
                document.getElementById('sidebar').classList.remove('show');
            }

            window.scrollTo(0, 0);
        }

        // فتح وإغلاق الشريط الجانبي في الجوال
        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('show');
        }

        // مودال البوت
        function openBotModal() {
            document.getElementById('botModal').style.display = 'flex';
        }

        function closeBotModal() {
            document.getElementById('botModal').style.display = 'none';
        }

        function botNavigate(sectionId) {
            closeBotModal();
            const targetLink = document.querySelector(`[href='#${sectionId}']`);
            switchSection(sectionId, targetLink);
        }

        // وظيفة البحث السريع داخل الموقع
        function searchSite() {
            let input = document.getElementById('siteSearch').value.toLowerCase();
            let sections = ['home', 'elite', 'newspaper', 'interviews', 'servers', 'unknown'];
            
            if(input.trim() === '') return;

            // إذا كتب المستخدم كلمة مفتاحية، يمكن توجيهه أو إبراز النتائج
            if(input.includes('عليا') || input.includes('النخبة')) {
                switchSection('elite', document.querySelector('[href="#elite"]'));
            } else if(input.includes('صحيفة') || input.includes('دومين')) {
                switchSection('newspaper', document.querySelector('[href="#newspaper"]'));
            } else if(input.includes('مقابلات')) {
                switchSection('interviews', document.querySelector('[href="#interviews"]'));
            } else if(input.includes('سيرفر')) {
                switchSection('servers', document.querySelector('[href="#servers"]'));
            }
        }
    </script>
