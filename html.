    <!-- المحتوى الرئيسي -->
    <main>

        <!-- 1. الشاشة الرئيسية -->
        <section id="home" class="active-section">
            <h2 class="section-title">الشاشة الرئيسية</h2>
            
            <!-- شريط البحث والزر -->
            <div class="search-bot-bar">
                <div class="search-box">
                    <i class="fa-solid fa-magnifying-glass"></i>
