<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TEC Community</title>
    <!-- استيراد خط بيروتي من Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Beiruti:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- مكتبة أيقونات FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- مكتبة Model Viewer لعرض مجسمات 3D -->
    <script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/3.3.0/model-viewer.min.js"></script>

    <style>
        :root {
            --bg-main: #07090e;
            --bg-sidebar: #0d121d;
            --card-bg: #131a2b;
            --gold: #dfb15b;
            --gold-light: #f3e5ab;
            --gold-dark: #b8860b;
            --silver: #d1d5db;
            --silver-dark: #9ca3af;
            --white: #ffffff;
            --border-glow: rgba(223, 177, 91, 0.3);
            --transition: all 0.3s ease;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Beiruti', sans-serif;
            scroll-behavior: smooth;
        }

        body {
            background-color: var(--bg-main);
            color: var(--white);
            display: flex;
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* --- الشريط الجانبي (Sidebar) --- */
        aside {
            width: 280px;
            background-color: var(--bg-sidebar);
            border-left: 1px solid rgba(223, 177, 91, 0.2);
            position: fixed;
            height: 100vh;
            right: 0;
            top: 0;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            z-index: 1000;
            transition: var(--transition);
        }

        .sidebar-header {
            padding: 30px 20px;
            text-align: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .sidebar-header h1 {
            font-size: 26px;
            font-weight: 800;
            background: linear-gradient(135deg, var(--white), var(--gold), var(--silver));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            letter-spacing: 1px;
        }

        .sidebar-menu {
            list-style: none;
            padding: 20px 10px;
            flex-grow: 1;
            overflow-y: auto;
        }

        .sidebar-menu li {
            margin-bottom: 10px;
        }

        .sidebar-menu a {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 12px 18px;
            color: var(--silver);
            text-decoration: none;
            border-radius: 10px;
            font-size: 18px;
            font-weight: 500;
            transition: var(--transition);
        }

        .sidebar-menu a:hover, .sidebar-menu a.active {
            background: linear-gradient(90deg, rgba(223, 177, 91, 0.15), transparent);
            color: var(--gold);
            border-right: 4px solid var(--gold);
        }

        .sidebar-menu a i {
            font-size: 20px;
            color: var(--gold);
        }

        .sidebar-footer {
            padding: 20px;
            text-align: center;
            font-size: 14px;
            color: var(--silver-dark);
            border-top: 1px solid rgba(255, 255, 255, 0.05);
        }

        /* زر القائمة للجوال */
        .mobile-toggle {
            display: none;
            position: fixed;
            top: 20px;
            left: 20px;
            background: var(--card-bg);
            border: 1px solid var(--gold);
            color: var(--gold);
            padding: 10px 15px;
            border-radius: 8px;
            font-size: 20px;
            z-index: 1001;
            cursor: pointer;
        }

        /* --- المحتوى الرئيسي (Main Content) --- */
        main {
            margin-right: 280px;
            flex-grow: 1;
            padding: 40px;
            transition: var(--transition);
        }

        section {
            display: none;
            animation: fadeIn 0.5s ease-in-out;
        }

        section.active-section {
            display: block;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .section-title {
            font-size: 32px;
            font-weight: 700;
            margin-bottom: 25px;
            color: var(--white);
            border-bottom: 2px solid var(--gold);
            padding-bottom: 10px;
            display: inline-block;
        }

        /* --- الشاشة الرئيسية --- */
        .hero-top {
            display: grid;
            grid-template-columns: 1fr 350px;
            gap: 30px;
            align-items: center;
            margin-bottom: 40px;
        }

        .hero-info h2 {
            font-size: 38px;
            color: var(--gold);
            margin-bottom: 15px;
        }

        .hero-info p {
            font-size: 18px;
            color: var(--silver);
            line-height: 1.8;
            margin-bottom: 25px;
        }

        /* شريط البحث والزر */
        .search-bot-bar {
            display: flex;
            gap: 15px;
            margin-bottom: 30px;
        }

        .search-box {
            flex-grow: 1;
            position: relative;
        }

        .search-box input {
            width: 100%;
            padding: 14px 20px 14px 50px;
            background: var(--card-bg);
            border: 1px solid rgba(223, 177, 91, 0.3);
            border-radius: 12px;
            color: var(--white);
            font-size: 16px;
            outline: none;
            transition: var(--transition);
        }

        .search-box input:focus {
            border-color: var(--gold);
            box-shadow: 0 0 15px rgba(223, 177, 91, 0.2);
        }

        .search-box i {
            position: absolute;
            left: 20px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--gold);
            font-size: 18px;
        }

        .bot-btn {
            background: linear-gradient(135deg, var(--gold), var(--gold-dark));
            color: var(--bg-main);
            border: none;
            padding: 0 25px;
            border-radius: 12px;
            font-weight: 700;
            font-size: 16px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 10px;
            transition: var(--transition);
        }

        .bot-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 0 20px rgba(223, 177, 91, 0.4);
        }

        /* حاوية اللوغو 3D */
        .logo-3d-container {
            width: 100%;
            height: 300px;
            background: var(--card-bg);
            border: 2px dashed var(--gold);
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
        }

        model-viewer {
            width: 100%;
            height: 100%;
        }

        .logo-placeholder-text {
            text-align: center;
            color: var(--silver);
            padding: 20px;
        }

        .logo-placeholder-text i {
            font-size: 40px;
            color: var(--gold);
            margin-bottom: 10px;
        }

        /* بطاقة المؤسس */
        .founder-card {
            background: var(--card-bg);
            border: 1px solid rgba(223, 177, 91, 0.2);
            border-radius: 16px;
            padding: 25px;
            margin-bottom: 30px;
            display: flex;
            align-items: center;
            gap: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }

        .founder-avatar {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--gold), var(--silver));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
            color: var(--bg-main);
            font-weight: 800;
        }

        .founder-info h3 {
            color: var(--gold);
            font-size: 22px;
            margin-bottom: 5px;
        }

        .founder-info p {
            color: var(--silver);
            font-size: 16px;
        }

        /* أزرار الروابط الأربعة الرئيسية */
        .hero-links-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
        }

        .hero-link-btn {
            background: var(--card-bg);
            border: 1px solid rgba(223, 177, 91, 0.3);
            border-radius: 14px;
            padding: 20px;
            text-align: center;
            text-decoration: none;
            color: var(--white);
            font-size: 18px;
            font-weight: 600;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 12px;
            transition: var(--transition);
        }

        .hero-link-btn i {
            font-size: 28px;
            color: var(--gold);
        }

        .hero-link-btn:hover {
            border-color: var(--gold);
            background: linear-gradient(135deg, rgba(223, 177, 91, 0.1), var(--card-bg));
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(223, 177, 91, 0.15);
        }

        /* --- البطاقات العامة والشبكات --- */
        .cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 25px;
            margin-top: 20px;
        }

        .card {
            background: var(--card-bg);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 16px;
            padding: 25px;
            text-align: center;
            transition: var(--transition);
        }

        .card:hover {
            border-color: var(--gold);
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.6);
        }

        .card-img-placeholder {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            background: rgba(255,255,255,0.05);
            border: 2px dashed var(--silver-dark);
            margin: 0 auto 20px auto;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--silver-dark);
            font-size: 24px;
        }

        .card h3 {
            color: var(--gold);
            font-size: 20px;
            margin-bottom: 10px;
        }

        .card p {
            color: var(--silver);
            font-size: 15px;
        }

        /* قسم الصحف والمقابلات (قائد ونائب وطاقم) */
        .leadership-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 25px;
            margin-bottom: 30px;
        }

        .leader-card {
            background: linear-gradient(135deg, rgba(223, 177, 91, 0.1), var(--card-bg));
            border: 1px solid var(--gold);
            border-radius: 16px;
            padding: 30px;
            text-align: center;
        }

        /* الأقسام المقفلة للصيانة */
        .maintenance-box {
            text-align: center;
            padding: 80px 20px;
            background: var(--card-bg);
            border: 1px dashed rgba(223, 177, 91, 0.3);
            border-radius: 20px;
            margin-top: 30px;
        }

        .maintenance-box i {
            font-size: 60px;
            color: var(--gold);
            margin-bottom: 20px;
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.1); opacity: 0.7; }
            100% { transform: scale(1); opacity: 1; }
        }

        .maintenance-box h3 {
            font-size: 28px;
            color: var(--white);
            margin-bottom: 10px;
        }

        .maintenance-box p {
            font-size: 18px;
            color: var(--silver);
        }

        /* مودال المساعد الذكي (Bot Modal) */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.8);
            backdrop-filter: blur(5px);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 2000;
        }

        .modal-content {
            background: var(--bg-sidebar);
            border: 1px solid var(--gold);
            width: 90%;
            max-width: 500px;
            border-radius: 20px;
            padding: 30px;
            position: relative;
            box-shadow: 0 15px 40px rgba(0,0,0,0.8);
        }

        .modal-close {
            position: absolute;
            top: 15px;
            left: 20px;
            background: none;
            border: none;
            color: var(--silver);
            font-size: 22px;
            cursor: pointer;
        }

        .modal-header {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 20px;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            padding-bottom: 15px;
        }

        .modal-header i {
            font-size: 30px;
            color: var(--gold);
        }

        .bot-links {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .bot-link-item {
            background: var(--card-bg);
            border: 1px solid rgba(223, 177, 91, 0.2);
            padding: 12px 18px;
            border-radius: 10px;
            color: var(--white);
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: space-between;
            transition: var(--transition);
        }

        .bot-link-item:hover {
            background: rgba(223, 177, 91, 0.15);
            border-color: var(--gold);
            padding-right: 22px;
        }

        /* --- التصميم المتجاوب (Responsive) --- */
        @media (max-width: 992px) {
            aside {
                right: -280px;
            }
            aside.show {
                right: 0;
            }
            main {
                margin-right: 0;
                padding: 20px;
                padding-top: 80px;
            }
            .mobile-toggle {
                display: block;
            }
            .hero-top {
                grid-template-columns: 1fr;
            }
            .leadership-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>

    <!-- زر القائمة للجوال -->
    <button class="mobile-toggle" onclick="toggleSidebar()">
        <i class="fa-solid fa-bars"></i>
    </button>

    <!-- الشريط الجانبي للتنقل -->
    <aside id="sidebar">
        <div class="sidebar-header">
            <h1>TEC COMMUNITY</h1>
