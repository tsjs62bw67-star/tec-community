    <!-- \uc0\u1605 \u1608 \u1583 \u1575 \u1604  \u1605 \u1587 \u1575 \u1593 \u1583  \u1575 \u1604 \u1576 \u1608 \u1578  \u1575 \u1604 \u1605 \u1585 \u1576 \u1608 \u1591  \u1576 \u1580 \u1605 \u1610 \u1593  \u1575 \u1604 \u1571 \u1602 \u1587 \u1575 \u1605  -->\
    <div class="modal-overlay" id="botModal">\
        <div class="modal-content">\
            <button class="modal-close" onclick="closeBotModal()"><i class="fa-solid fa-xmark"></i></button>\
            <div class="modal-header">\
                <i class="fa-solid fa-robot"></i>\
                <div>\
                    <h3 style="color: var(--gold); font-size: 20px;">\uc0\u1605 \u1587 \u1575 \u1593 \u1583  \u1578 \u1610 \u1603  \u1575 \u1604 \u1584 \u1603 \u1610 </h3>\
                    <p style="color: var(--silver); font-size: 14px;">\uc0\u1575 \u1582 \u1578 \u1585  \u1575 \u1604 \u1602 \u1587 \u1605  \u1575 \u1604 \u1584 \u1610  \u1578 \u1585 \u1594 \u1576  \u1576 \u1575 \u1604 \u1575 \u1606 \u1578 \u1602 \u1575 \u1604  \u1573 \u1604 \u1610 \u1607  \u1601 \u1608 \u1585 \u1575 \u1611 :</p>\
                </div>\
            </div>\
            <div class="bot-links">\
                <a href="#home" class="bot-link-item" onclick="botNavigate('home')"><span>\uc0\u1575 \u1604 \u1588 \u1575 \u1588 \u1577  \u1575 \u1604 \u1585 \u1574 \u1610 \u1587 \u1610 \u1577 </span><i class="fa-solid fa-arrow-left"></i></a>\
                <a href="#elite" class="bot-link-item" onclick="botNavigate('elite')"><span>\uc0\u1593 \u1604 \u1610 \u1575  \u1575 \u1604 \u1578 \u1610 \u1603 </span><i class="fa-solid fa-arrow-left"></i></a>\
                <a href="#newspaper" class="bot-link-item" onclick="botNavigate('newspaper')"><span>\uc0\u1589 \u1581 \u1610 \u1601 \u1577  \u1575 \u1604 \u1578 \u1610 \u1603  (\u1578 \u1610 \u1603  \u1583 \u1608 \u1605 \u1610 \u1606 )</span><i class="fa-solid fa-arrow-left"></i></a>\
                <a href="#interviews" class="bot-link-item" onclick="botNavigate('interviews')"><span>\uc0\u1605 \u1602 \u1575 \u1576 \u1604 \u1575 \u1578  \u1575 \u1604 \u1578 \u1610 \u1603 </span><i class="fa-solid fa-arrow-left"></i></a>\
                <a href="#servers" class="bot-link-item" onclick="botNavigate('servers')"><span>\uc0\u1587 \u1610 \u1585 \u1601 \u1585 \u1575 \u1578  \u1578 \u1610 \u1603  (\u1589 \u1610 \u1575 \u1606 \u1577 )</span><i class="fa-solid fa-arrow-left"></i></a>\
                <a href="#unknown" class="bot-link-item" onclick="botNavigate('unknown')"><span>\uc0\u1605 \u1580 \u1607 \u1608 \u1604  (\u1589 \u1610 \u1575 \u1606 \u1577 )</span><i class="fa-solid fa-arrow-left"></i></a>\
            </div>\
        </div>\
    </div>\
\
    <!-- JavaScript \uc0\u1604 \u1604 \u1578 \u1606 \u1602 \u1604  \u1608 \u1575 \u1604 \u1578 \u1601 \u1575 \u1593 \u1604  -->\
    <script>\
        // \uc0\u1578 \u1576 \u1583 \u1610 \u1604  \u1575 \u1604 \u1571 \u1602 \u1587 \u1575 \u1605  \u1593 \u1576 \u1585  \u1575 \u1604 \u1588 \u1585 \u1610 \u1591  \u1575 \u1604 \u1580 \u1575 \u1606 \u1576 \u1610  \u1608 \u1575 \u1604 \u1588 \u1575 \u1588 \u1577 \
        function switchSection(sectionId, element) \{\
            // \uc0\u1573 \u1582 \u1601 \u1575 \u1569  \u1580 \u1605 \u1610 \u1593  \u1575 \u1604 \u1571 \u1602 \u1587 \u1575 \u1605 \
            document.querySelectorAll('main section').forEach(sec => \{\
                sec.classList.remove('active-section');\
            \});\
\
            // \uc0\u1573 \u1592 \u1607 \u1575 \u1585  \u1575 \u1604 \u1602 \u1587 \u1605  \u1575 \u1604 \u1605 \u1591 \u1604 \u1608 \u1576 \
            document.getElementById(sectionId).classList.add('active-section');\
\
            // \uc0\u1578 \u1581 \u1583 \u1610 \u1579  \u1575 \u1604 \u1593 \u1606 \u1589 \u1585  \u1575 \u1604 \u1606 \u1588 \u1591  \u1601 \u1610  \u1575 \u1604 \u1602 \u1575 \u1574 \u1605 \u1577 \
            document.querySelectorAll('.sidebar-menu a').forEach(link => \{\
                link.classList.remove('active');\
            \});\
            if(element) \{\
                element.classList.add('active');\
            \}\
\
            // \uc0\u1573 \u1594 \u1604 \u1575 \u1602  \u1575 \u1604 \u1588 \u1585 \u1610 \u1591  \u1575 \u1604 \u1580 \u1575 \u1606 \u1576 \u1610  \u1601 \u1610  \u1575 \u1604 \u1580 \u1608 \u1575 \u1604  \u1578 \u1604 \u1602 \u1575 \u1574 \u1610 \u1575 \u1611  \u1593 \u1606 \u1583  \u1575 \u1604 \u1606 \u1602 \u1585 \
            if(window.innerWidth <= 992) \{\
                document.getElementById('sidebar').classList.remove('show');\
            \}\
\
            window.scrollTo(0, 0);\
        \}\
\
        // \uc0\u1601 \u1578 \u1581  \u1608 \u1573 \u1594 \u1604 \u1575 \u1602  \u1575 \u1604 \u1588 \u1585 \u1610 \u1591  \u1575 \u1604 \u1580 \u1575 \u1606 \u1576 \u1610  \u1601 \u1610  \u1575 \u1604 \u1580 \u1608 \u1575 \u1604 \
        function toggleSidebar() \{\
            document.getElementById('sidebar').classList.toggle('show');\
        \}\
\
        // \uc0\u1605 \u1608 \u1583 \u1575 \u1604  \u1575 \u1604 \u1576 \u1608 \u1578 \
        function openBotModal() \{\
            document.getElementById('botModal').style.display = 'flex';\
        \}\
\
        function closeBotModal() \{\
            document.getElementById('botModal').style.display = 'none';\
        \}\
\
        function botNavigate(sectionId) \{\
            closeBotModal();\
            const targetLink = document.querySelector(`[href='#$\{sectionId\}']`);\
            switchSection(sectionId, targetLink);\
        \}\
\
        // \uc0\u1608 \u1592 \u1610 \u1601 \u1577  \u1575 \u1604 \u1576 \u1581 \u1579  \u1575 \u1604 \u1587 \u1585 \u1610 \u1593  \u1583 \u1575 \u1582 \u1604  \u1575 \u1604 \u1605 \u1608 \u1602 \u1593 \
        function searchSite() \{\
            let input = document.getElementById('siteSearch').value.toLowerCase();\
            let sections = ['home', 'elite', 'newspaper', 'interviews', 'servers', 'unknown'];\
            \
            if(input.trim() === '') return;\
\
            // \uc0\u1573 \u1584 \u1575  \u1603 \u1578 \u1576  \u1575 \u1604 \u1605 \u1587 \u1578 \u1582 \u1583 \u1605  \u1603 \u1604 \u1605 \u1577  \u1605 \u1601 \u1578 \u1575 \u1581 \u1610 \u1577 \u1548  \u1610 \u1605 \u1603 \u1606  \u1578 \u1608 \u1580 \u1610 \u1607 \u1607  \u1571 \u1608  \u1573 \u1576 \u1585 \u1575 \u1586  \u1575 \u1604 \u1606 \u1578 \u1575 \u1574 \u1580 \
            if(input.includes('\uc0\u1593 \u1604 \u1610 \u1575 ') || input.includes('\u1575 \u1604 \u1606 \u1582 \u1576 \u1577 ')) \{\
                switchSection('elite', document.querySelector('[href="#elite"]'));\
            \} else if(input.includes('\uc0\u1589 \u1581 \u1610 \u1601 \u1577 ') || input.includes('\u1583 \u1608 \u1605 \u1610 \u1606 ')) \{\
                switchSection('newspaper', document.querySelector('[href="#newspaper"]'));\
            \} else if(input.includes('\uc0\u1605 \u1602 \u1575 \u1576 \u1604 \u1575 \u1578 ')) \{\
                switchSection('interviews', document.querySelector('[href="#interviews"]'));\
            \} else if(input.includes('\uc0\u1587 \u1610 \u1585 \u1601 \u1585 ')) \{\
                switchSection('servers', document.querySelector('[href="#servers"]'));\
            \}\
        \}\
    </script>\
</body>\
</html>}
