                </div>
                <div class="logo-3d-container">
                    <!-- اسم الملف المقترح للوغو 3D: tec-logo-3d.glb -->
                    <model-viewer src="tec-logo-3d.glb" alt="TEC 3D Logo" auto-rotate camera-controls disable-zoom>
                        <div slot="poster" class="logo-placeholder-text">
                            <i class="fa-solid fa-cube"></i>
                            <p>ضع ملف اللوغو 3D باسم:<br><b>tec-logo-3d.glb</b></p>
                        </div>
                    </model-viewer>
                </div>
            </div>

            <!-- بطاقة تعريف المؤسس -->
            <div class="founder-card">
                <div class="founder-avatar">
                    <i class="fa-solid fa-user-tie"></i>
                </div>
                <div class="founder-info">
                    <h3>المؤسس والرئيس التنفيذي</h3>
                    <p>القائد والمؤسس لمجتمع TEC Community، المشرف على الرؤية الاستراتيجية وتطوير الأقسام والفعاليات التقنية.</p>
